{
  "name": "apuracao-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Acompanhamento da apuração das Eleições 2026 (dados oficiais do TSE)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.mjs\" \"vite\"",
    "demo": "DEMO=1 npm run dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --max-old-space-size=384 server/index.mjs",
    "typecheck": "tsc --noEmit",
    "candidatos": "node server/scripts/candidatos.mjs",
    "arquivar": "node server/scripts/arquivar.mjs",
    "simular-2turno": "node server/scripts/simular-2turno.mjs",
    "zonas": "node server/scripts/zonas.mjs",
    "icones": "cd public && rsvg-convert -w 192 -h 192 favicon.svg -o icone-192.png && rsvg-convert -w 512 -h 512 favicon.svg -o icone-512.png && rsvg-convert -w 512 -h 512 icone-maskable.svg -o icone-maskable-512.png && rsvg-convert -w 180 -h 180 icone-maskable.svg -o apple-touch-icon.png",
    "og": "chromium --headless --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=1200,630 --virtual-time-budget=8000 --screenshot=public/og.png \"file://$PWD/server/scripts/og.html\"",
    "dev:2turno": "SIMULACAO_2TURNO=1 FLAG_SEGUNDO_TURNO=on npm run dev"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "d3-delaunay": "^6.0.4",
    "polygon-clipping": "^0.15.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
