{
  "name": "apuracao-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Acompanhamento da apuração das Eleições 2026 (dados oficiais do TSE)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.mjs\" \"vite\"",
    "demo": "DEMO=1 npm run dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --max-old-space-size=384 server/index.mjs",
    "typecheck": "tsc --noEmit",
    "candidatos": "node server/scripts/candidatos.mjs",
    "arquivar": "node server/scripts/arquivar.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
